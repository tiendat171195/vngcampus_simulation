# One host for everything (docs/09 §3): the browser only ever calls its own origin.
#   /            the game (static, SPA)          /admin/*  the admin (static, SPA)
#   /api/*       the API                         /rt/*     the realtime server (WebSocket)
#
# SITE_ADDRESS is the public name (Caddy fetches the certificate itself), or ":80" behind a
# CDN or load balancer that terminates TLS.

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Everything comes from this origin: no inline or remote script, no framing (docs/09 §7).
		# Inline style attributes stay allowed (React `style={…}`, SVG maps in the admin).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3001
	}

	handle_path /rt/* {
		# Operational endpoints stay on the private network (read there, never public). Inside
		# this block so it runs before the proxy; the prefix is already stripped here.
		@private path /metrics /metrics/*
		respond @private 404
		# Long-lived WebSockets: no buffering; the realtime server tells clients when it restarts.
		reverse_proxy realtime:2567 {
			flush_interval -1
		}
	}

	redir /admin /admin/ 308
	handle_path /admin/* {
		root * /srv/admin
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /srv/web
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
