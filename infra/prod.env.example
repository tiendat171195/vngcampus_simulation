# Copy to infra/prod.env on the server and fill in. Never commit prod.env: it holds secrets.
# Used by compose.prod.yaml both for ${…} in that file and as the environment of the app containers.

# --- images and address -------------------------------------------------------------------------
# Where the deploy workflow pushes images, and which version to run (a git SHA or v1.2.3).
IMAGE_REPO=ghcr.io/OWNER/REPO
IMAGE_TAG=latest
# Public host name; Caddy gets the TLS certificate for it. ":80" behind a CDN that terminates TLS.
SITE_ADDRESS=campus.example.com
# The same address as people type it, for sign-in redirects.
PUBLIC_URL=https://campus.example.com

# --- database ------------------------------------------------------------------------------------
# A long random password; write it twice (compose does not expand variables inside this file).
POSTGRES_PASSWORD=
DATABASE_URL=postgres://campus:PASSWORD@postgres:5432/campus
# Nightly dump time (Vietnam time), how many days to keep, and where on the host.
BACKUP_AT=02:30
BACKUP_KEEP_DAYS=14
BACKUP_DIR=./backups

# --- api -----------------------------------------------------------------------------------------
# `node scripts/generate-jwt-key.mjs` prints this line. Changing it signs everyone out.
JWT_PRIVATE_KEY=
LOG_LEVEL=info
# off | limited | full — a company deployment usually wants off (company accounts only).
GUEST_MODE=off
# Company sign-in: Google and/or any OpenID Connect provider (see .env.example for details).
# Register <PUBLIC_URL>/api/v1/auth/oidc/<google|oidc>/callback with the provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_LABEL=tài khoản VNG
AUTH_EMAIL_DOMAINS=vng.com.vn
# The first administrators; they grant roles to others in the admin.
ADMIN_EMAILS=

# --- realtime ------------------------------------------------------------------------------------
AUTH_JWKS_URL=http://api:3001/api/v1/auth/jwks
# At least 32 random characters (e.g. `openssl rand -base64 33`). Changing it makes everyone "new".
ANALYTICS_SALT=
# CHANNEL_SOFT_CAP=80
# CHANNEL_HARD_CAP=100
