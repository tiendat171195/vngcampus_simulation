# Copy to `.env` to override. Every value here is already the built-in default, so the file is
# optional in development. Never commit real secrets.

# --- apps/api -----------------------------------------------------------------------------------
# Bind address. Use 0.0.0.0 inside a container.
API_HOST=127.0.0.1
API_PORT=3001
LOG_LEVEL=info

# --- apps/realtime ------------------------------------------------------------------------------
REALTIME_HOST=127.0.0.1
REALTIME_PORT=2567
# Accept self-chosen guest identities (development only, until real sign-in). Default: on unless NODE_ENV=production.
# DEV_GUEST_AUTH=on
# Channel sizes (defaults 80 / 100).
# CHANNEL_SOFT_CAP=80
# CHANNEL_HARD_CAP=100

# --- local services from `pnpm infra:up` (not read by any app yet; used from P2.3 / P3.1) --------
DATABASE_URL=postgres://campus:campus@localhost:5432/campus
REDIS_URL=redis://localhost:6379
