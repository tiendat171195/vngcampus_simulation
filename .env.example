# Copy to `.env` to override. Every value here is already the built-in default, so the file is
# optional in development. Never commit real secrets.

# --- apps/api -----------------------------------------------------------------------------------
# Bind address. Use 0.0.0.0 inside a container.
API_HOST=127.0.0.1
API_PORT=3001
LOG_LEVEL=info

DATABASE_URL=postgres://campus:campus@127.0.0.1:5432/campus
# ES256 private key (PKCS#8 PEM, newlines as \n). Required in production; development makes a new
# one at each start, which signs everyone out on restart.
# JWT_PRIVATE_KEY=
# off | limited | full
GUEST_MODE=full
# Multiplies the per-address limits of the sign-in routes (guest sign-up 10/min, refresh 300/min).
# RATE_LIMIT_SCALE=1
# Address people open the game at; sign-in providers send them back to
# <PUBLIC_URL>/api/v1/auth/oidc/<google|oidc>/callback (register that redirect URI with them).
# PUBLIC_URL=http://localhost:5173
# Google sign-in: an OAuth client of type "Web application".
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Any other OpenID Connect provider (Microsoft Entra ID: https://login.microsoftonline.com/<tenant>/v2.0).
# To try company sign-in locally, run `pnpm --filter @campus/mock-idp start` and use:
# OIDC_ISSUER=http://127.0.0.1:3920
# OIDC_CLIENT_ID=campus-dev
# OIDC_CLIENT_SECRET=campus-dev-secret
# OIDC_LABEL=Mock IdP
# Comma-separated email domains allowed to sign in with a provider. Required in production.
# AUTH_EMAIL_DOMAINS=vng.com.vn
# Comma-separated addresses that become administrators when they sign in with a provider.
# ADMIN_EMAILS=

# --- apps/realtime ------------------------------------------------------------------------------
REALTIME_HOST=127.0.0.1
REALTIME_PORT=2567
# Missions and progress; the API applies the migrations. Defaults to the API's DATABASE_URL value.
# DATABASE_URL=postgres://campus:campus@127.0.0.1:5432/campus
# Where the API publishes the public keys of access tokens; players join with those tokens.
# AUTH_JWKS_URL=http://127.0.0.1:3001/api/v1/auth/jwks
# Also accept self-chosen identities without a token, for load-test bots. Never on a server
# reachable from the internet. Default: on unless NODE_ENV=production.
# DEV_GUEST_AUTH=on
# Let the client pick where to appear with ?spawn=<poi id>. Default: on unless NODE_ENV=production.
# DEV_SPAWN=on
# Channel sizes (defaults 80 / 100).
# CHANNEL_SOFT_CAP=80
# CHANNEL_HARD_CAP=100

# --- local services from `pnpm infra:up` --------------------------------------------------------
# Redis: not used yet (scaling, P7).
# REDIS_URL=redis://localhost:6379
# Integration tests of the API rebuild this database from the migrations.
TEST_DATABASE_URL=postgres://campus:campus@127.0.0.1:5432/campus_test
