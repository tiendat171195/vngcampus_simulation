{
  "name": "vngcampus-simulation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "smoke": "node scripts/smoke.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm smoke",
    "infra:up": "docker compose -f infra/compose.dev.yaml up -d --wait",
    "infra:down": "docker compose -f infra/compose.dev.yaml down"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
